<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="#161722"
    android:orientation="vertical"
    android:padding="12dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- टूल आइकन -->
        <TextView
            android:id="@+id/tvToolIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛠️"
            android:textSize="28sp" />

        <!-- बैज (AI / OFFLINE) -->
        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="#242538"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="OFFLINE"
            android:textColor="#00FFB2"
            android:textSize="10sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- टूल का नाम -->
    <TextView
        android:id="@+id/tvToolName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Tool Name"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- छोटी डिटेल -->
    <TextView
        android:id="@+id/tvToolDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Fast and lightweight tool"
        android:textColor="#78788C"
        android:textSize="11sp" />

</LinearLayout>
